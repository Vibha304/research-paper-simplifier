# Copy to .env and adjust. All values are optional - the app works with no .env at all.

# Analysis engine: "builtin" (default - no installs, no internet) or "ollama" (optional local AI model)
RPS_ENGINE=builtin

# --- Only used when RPS_ENGINE=ollama ---
RPS_OLLAMA_BASE_URL=http://localhost:11434
RPS_LLM_MODEL=llama3.2               # 3B; use llama3.2:1b on low-RAM laptops
RPS_EMBEDDING_MODEL=nomic-embed-text
RPS_LLM_TEMPERATURE=0.2
RPS_LLM_NUM_CTX=8192                 # context window (tokens); lower to 4096 to save RAM
RPS_LLM_TIMEOUT_SECONDS=300
RPS_LLM_MAX_RETRIES=2


# --- General ---
RPS_DATA_DIR=./data                  # SQLite, ChromaDB and logs live here
RPS_LOG_LEVEL=INFO

RPS_MAX_PAGES=100
RPS_MAX_FILE_SIZE_MB=50              # keep in sync with .streamlit/config.toml maxUploadSize
RPS_MIN_CHARS_PER_PAGE=80            # below this the PDF is treated as scanned

RPS_CHUNK_SIZE=1400
RPS_CHUNK_OVERLAP=200
RPS_RETRIEVAL_TOP_K=6
RPS_MAX_CONTEXT_CHARS=9000
RPS_EMBED_BATCH_SIZE=16
RPS_CHAT_HISTORY_TURNS=4
